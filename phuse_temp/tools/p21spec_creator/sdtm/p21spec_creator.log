51         *******************************************************************************;
52         * Run configuration ;
53         * By default, values are derived from init-variables and/or set to standard ;
54         * values - in most cases this is expected to work "out of the box", but ;
55         * in some cases special configuration might be needed.
56         *******************************************************************************;
57         
58         * Set working directory - depending on whether program is inculded or run as "stand alone";
59         * adding backslash to SYSINCLUDEFILEDIR to match the format of _PGMPATH ;
60         %if "&SYSINCLUDEFILEDIR." ne "" %then %do;
61           %let wd = &SYSINCLUDEFILEDIR.\;
62         %end;
63         %else %do;
64           %let wd = &_PGMPATH.;
65         %end;
66         
67         * Set STUDYCD and SCOPE (SCOPE is expected to be SDTM or ADAM.) ;
68         %global /readonly __studycd = &_STUDYID.;
69         %global /readonly __scope = %upcase(%scan(%str(&wd.),-1,%str(\)));
70         
71         * Set entry/upload file;
72         %let entryfile = &__scope._Mapping_Specifications_Entry_&__studycd..xlsx;
73         %let p21uploadfile = P21_UPLOAD_&__scope._Mapping_Specifications_&__studycd..xlsx;
74         
75         * Set name of 'drop variable';
76         %let drop_variable = %upcase(&__studycd.);
77         
78         *******************************************************************************;
79         * Derive / Set up static configuration and envrionment ;
80         * (configuration below this point should not be needed) ;
81         *******************************************************************************;
82         
83         * Define paths to the tool and data folder;
84         %global /readonly toolpath = &wd...\macro\;
85         %global /readonly datapath = &wd.\data;
86         
87         * Concatenate full paths for the entry and upload file (the upload file is not ;
88         * readonly, as it might have to be changed in case of access conflicts ;
3                                           The SAS System             00:12 Tuesday, October 14, 2025

