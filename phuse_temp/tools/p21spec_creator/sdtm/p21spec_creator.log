1          /*******************************************************************************
2          Project Name    : general
3          Program Name    : p21spec_creator.sas
4          Program Author  : Thomas Gulholm-Hansen (TGUH)
5          Program Purpose : This is the main "driver program" of the p21spec-creator
6                            package. The program contains 3 main sections:
7                            1. Configuration and data-load - sets up the "environment" and
8                               read the contents of the entry-files into SAS datasets
9                               in the 'defdata' library.
10                           2. Manipulation of spec sheet-data; this is where all the
11                              "magic" happens, e.g., creation of actual method/comment
12                              entries and creatoin of variables form core-groups. This
13                              section is mostly calls to macros that do the actual work.
14                           3. Finalization and creation of p21upload-file. The final
15                              "sheet-dataset" are stored in the 'defdata' library (for
16                              reference/potential future use), and the p21upload-file
17                              is re-written - if the p21upload-file exists, and cannot
18                              be deleted, a "personal copy" (with leading initials and
19                              datetime) is writen
20         
21                           The program is intended to be placed in a folder named 'sdtm'
22                           or 'adam' under .\tools\p21spec_creator in the standard milestone
23                           folder structure. The sdtm/adam folder must also contain the
24                           autoexec.sas file and a subfolder named 'data' (used for the
25                           'defdata' library.
26         *******************************************************************************/
27         
28         *******************************************************************************;
29         * AUTOEXEC - included for demonstration purpose only ;
30         * This sections sets a few variables that - in a production envrionemnt - would;
31         * be set by an autoexec/initialization macro;
32         *******************************************************************************;
33         %global _PGMPATH _STUDYID PROGDOC;
34         * Set the "current folder", from where the program is being executed ;
2                                           The SAS System             00:12 Tuesday, October 14, 2025

35         * (this is where the p21spec_creator code-base, and SAS dataset ;
36         * containing "define data" are stored - in relevant sub-folders) ;
37         %let _PGMPATH = S:\Biometrics\CNP\ASND0036\phuse_temp\tools\p21spec_creator\sdtm\;
38         * Set path to the "trial level documents for programming" folder ;
39         * (this is where (in subfolders) the "Entry-file" is read from, ;
40         * and the "Upload-file" is written to) ;
41         %let PROGDOC = S:\Biometrics\CNP\ASND0036\phuse_temp\progdoc;
42         * Set the Study-ID ;
43         * (this is used by the p21spec_creator to drive default names of the "Upload" ;
44         * and "Entry-file" as well as the name of the "drop-column " ;
45         %let _STUDYID = PHUSE;
46         *******************************************************************************;
47         * End of AUTOEXEC - The remaining program is supposed to be kept as-is ;
48         * (maybe with a few modificatoins to the "Run configuration" section ;
